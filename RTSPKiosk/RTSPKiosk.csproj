  </ItemGroup>
  <ItemGroup>
    <!-- Don't move to 6.2.15: its build targets require .NET Native framework 2.3.60521 but it
         ships 2.3.60518, so the app won't register on a device without the Store.
         Test-PackageDependencies.ps1 fails the build if this kind of mismatch returns. -->
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform" Version="6.2.14" />
    <PackageReference Include="FFmpegInteropX.UWP" Version="2.1.0.81200" />
  </ItemGroup>
  <ItemGroup>
    <!-- FFmpegInteropX.dll links the *_APP C++ runtime; LTSC has no Store to supply it, so declare the framework dependency. -->
    <SDKReference Include="Microsoft.VCLibs, Version=14.0">
      <Name>Microsoft.VCLibs</Name>
    </SDKReference>
  </ItemGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '14.0' ">
